# Copie este arquivo para .env (cp .env.example .env) e preencha. O .env nunca vai para o Git.

# Supabase → Settings → API Keys. Use a chave secreta NOVA (começa com sb_secret_).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=COLE-AQUI
# Usado só na instalação, para a CLI do Supabase aplicar a migração (npx supabase link / db push).
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Fuso dos horários que você digita no --quando.
FUSO_HORARIO=America/Sao_Paulo

# App da Meta (developers.facebook.com → seu app). Depois do "npm run configurar", a chave secreta
# fica guardada no cofre do Supabase e esta linha é esvaziada sozinha.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0
